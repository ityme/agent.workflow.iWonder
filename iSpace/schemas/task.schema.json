{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwonder.local/schemas/task.schema.json",
  "title": "Harness Task",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "title",
    "profile",
    "state",
    "created_at",
    "acceptance_criteria"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9]{3}_[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "waiting_ack",
        "passed",
        "failed",
        "blocked",
        "exited"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
