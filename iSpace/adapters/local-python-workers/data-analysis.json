{
  "adapter_id": "local-python-workers.data-analysis",
  "version": "1.0.0",
  "default_timeout_seconds": 60,
  "allowlist": [
    ["python", "iSpace/workers/data-analysis/analyst_worker.py"],
    ["python", "iSpace/workers/data-analysis/verifier_worker.py"],
    ["python", "iSpace/workers/data-analysis/reporter_worker.py"]
  ],
  "roles": {
    "analyst": {
      "command": ["python", "iSpace/workers/data-analysis/analyst_worker.py"],
      "input_file": "{attempt_dir}/input.json",
      "output_file": "{attempt_dir}/result.json",
      "timeout_seconds": 60,
      "workspace": "{harness_root}/tmp/workspaces/{run_id}/{task_id}/analyst"
    },
    "verifier": {
      "command": ["python", "iSpace/workers/data-analysis/verifier_worker.py"],
      "input_file": "{attempt_dir}/input.json",
      "output_file": "{attempt_dir}/result.json",
      "timeout_seconds": 60,
      "workspace": "{harness_root}/tmp/workspaces/{run_id}/{task_id}/verifier"
    },
    "reporter": {
      "command": ["python", "iSpace/workers/data-analysis/reporter_worker.py"],
      "input_file": "{attempt_dir}/input.json",
      "output_file": "{attempt_dir}/result.json",
      "timeout_seconds": 60,
      "workspace": "{harness_root}/tmp/workspaces/{run_id}/{task_id}/reporter"
    }
  },
  "permissions": {
    "allow_remote_write": false,
    "allow_publish": false,
    "allow_merge": false
  }
}
