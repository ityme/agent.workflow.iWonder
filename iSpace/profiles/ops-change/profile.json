{
  "profile_id": "ops-change",
  "version": "1.0.0",
  "description": "运维变更、配置变更和发布前检查 profile。",
  "roles": [
    {
      "role": "pm",
      "description": "确认变更目标、审批要求、风险边界和回滚条件。"
    },
    {
      "role": "planner",
      "description": "设计变更步骤、验证方式和回滚方案。"
    },
    {
      "role": "executor",
      "description": "在授权 workspace 或环境中执行变更。"
    },
    {
      "role": "validator",
      "description": "验证变更结果、健康状态和回滚可用性。"
    },
    {
      "role": "releaser",
      "description": "准备发布记录、审批材料和收口报告。"
    }
  ],
  "flow": [
    "pm",
    "planner",
    "executor",
    "validator",
    "releaser",
    "pm"
  ],
  "state_transitions": {
    "pm": {
      "intake": ["clarifying"],
      "clarifying": ["planned"],
      "planned": ["waiting_ack"],
      "waiting_ack": ["exited"]
    },
    "planner": {
      "planned": ["waiting_ack", "blocked"],
      "waiting_ack": ["exited"],
      "blocked": ["exited"]
    },
    "executor": {
      "running": ["waiting_ack", "blocked"],
      "waiting_ack": ["exited"],
      "blocked": ["exited"]
    },
    "validator": {
      "running": ["waiting_ack", "blocked"],
      "waiting_ack": ["exited"],
      "blocked": ["exited"]
    },
    "releaser": {
      "running": ["waiting_ack", "blocked"],
      "waiting_ack": ["exited"],
      "blocked": ["exited"]
    }
  },
  "retry_policy": {
    "max_attempts": 3,
    "stall_check_limit": 3,
    "fail_closed": true
  },
  "closeout_policy": {
    "default_action": "submit_approval",
    "external_publish_enabled": false,
    "external_merge_enabled": false
  }
}
